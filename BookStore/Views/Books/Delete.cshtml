@model BookStore.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="page-header">
    <a asp-action="Index" class="btn btn-warning me-3">
        <i class="fa-solid fa-arrow-left me-1"></i>Back
    </a>
    <h1><i class="fa-solid fa-trash-can me-2" style="color:#e74c3c;"></i>Delete Book</h1>
</div>

<div class="book-details-card" style="max-width:600px; margin:0 auto;">
    <div class="alert" style="background:rgba(231,76,60,0.08); border:1px solid #e74c3c; border-radius:var(--radius-sm); padding:1rem; margin-bottom:1.5rem;">
        <i class="fa-solid fa-triangle-exclamation me-2" style="color:#e74c3c;"></i>
        <strong>Warning:</strong> Are you sure you want to permanently delete this book?
    </div>

    <div class="d-flex gap-4 mb-4">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Title"
                 style="width:100px; height:140px; object-fit:cover; border-radius:var(--radius-sm); box-shadow:var(--shadow-md); flex-shrink:0;" />
        }
        <div>
            <h3 style="font-family:'Playfair Display',serif; margin-bottom:0.25rem;">@Model.Title</h3>
            <p class="text-muted mb-1">by @Model.Author</p>
            <p class="text-muted small mb-1">@Model.Language — @Model.ISBN</p>
            <p class="text-muted small mb-1">Published: @Model.DatePublished.ToString("MMMM dd, yyyy")</p>
            <p style="color:var(--accent); font-weight:700; font-size:1.1rem;">$@Model.Price</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p class="text-muted small mb-4">@Model.Description</p>
    }

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <input type="submit" value="Yes, Delete" class="btn btn-danger px-4" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
