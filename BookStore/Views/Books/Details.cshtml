@model BookStore.Models.Book

@{
    ViewData["Title"] = Model.Title + " - Details";
}

<div class="page-header">
    <a asp-action="Index" class="btn btn-warning me-3">
        <i class="fa-solid fa-arrow-left me-1"></i>Back
    </a>

    <h1>
        <i class="fa-solid fa-circle-info me-2" style="color:var(--accent)"></i>
        Book Details
    </h1>
</div>

<div class="book-details-card" style="max-width:700px; margin:0 auto;">
    <div class="row g-4">

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="col-md-4 text-center">
                <img src="@Model.ImageUrl"
                     alt="@Model.Title"
                     class="book-img-details"
                     style="max-height:280px; width:auto;" />
            </div>

            <div class="col-md-8">
                <h2 style="font-family:'Playfair Display',serif; margin-bottom:0.25rem;">
                    @Model.Title
                </h2>

                <p class="text-muted mb-3">
                    by <strong>@Model.Author</strong>
                </p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Language</dt>
                    <dd class="col-sm-8">@Model.Language</dd>

                    <dt class="col-sm-4">ISBN</dt>
                    <dd class="col-sm-8">
                        <small>@Model.ISBN</small>
                    </dd>

                    <dt class="col-sm-4">Published</dt>
                    <dd class="col-sm-8">
                        @Model.DatePublished.ToString("MMMM dd, yyyy")
                    </dd>

                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8"
                        style="color:var(--accent); font-weight:700; font-size:1.15rem;">
                        $@Model.Price
                    </dd>
                </dl>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <hr style="border-color:var(--border);" />
                    <p class="text-muted">@Model.Description</p>
                }
            </div>
        }
        else
        {
            <div class="col-12">

                <h2 style="font-family:'Playfair Display',serif; margin-bottom:0.25rem;">
                    @Model.Title
                </h2>

                <p class="text-muted mb-3">
                    by <strong>@Model.Author</strong>
                </p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Language</dt>
                    <dd class="col-sm-8">@Model.Language</dd>

                    <dt class="col-sm-4">ISBN</dt>
                    <dd class="col-sm-8">
                        <small>@Model.ISBN</small>
                    </dd>

                    <dt class="col-sm-4">Published</dt>
                    <dd class="col-sm-8">
                        @Model.DatePublished.ToString("MMMM dd, yyyy")
                    </dd>

                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8"
                        style="color:var(--accent); font-weight:700; font-size:1.15rem;">
                        $@Model.Price
                    </dd>
                </dl>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <hr style="border-color:var(--border);" />
                    <p class="text-muted">@Model.Description</p>
                }
            </div>
        }

    </div>

    <div class="d-flex gap-2 mt-4">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            <i class="fa-solid fa-pen-to-square me-1"></i>Edit
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-danger">
            <i class="fa-solid fa-trash-can me-1"></i>Delete
        </a>

        <a asp-action="Index"
           class="btn btn-secondary ms-auto">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>