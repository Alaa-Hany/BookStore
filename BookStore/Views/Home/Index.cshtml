@{
    ViewData["Title"] = "Welcome to BookStore";
}

<div class="hero-section">
    <h1>📚 Discover Your Next Book</h1>
    <p>Explore thousands of titles across every genre. From timeless classics to modern bestsellers.</p>
    <a asp-controller="Store" asp-action="Index" class="btn btn-primary btn-lg">
        Browse the Store <i class="fa-solid fa-arrow-right ms-2"></i>
    </a>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="book-details-card text-center" style="animation-delay:0.1s">
            <i class="fa-solid fa-truck-fast fa-2x mb-3" style="color:var(--accent)"></i>
            <h5>Fast Delivery</h5>
            <p class="text-muted mb-0">Get your books delivered quickly, right to your door.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="book-details-card text-center" style="animation-delay:0.2s">
            <i class="fa-solid fa-book-open fa-2x mb-3" style="color:var(--accent)"></i>
            <h5>Huge Selection</h5>
            <p class="text-muted mb-0">Thousands of books across all genres and languages.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="book-details-card text-center" style="animation-delay:0.3s">
            <i class="fa-solid fa-heart fa-2x mb-3" style="color:var(--accent)"></i>
            <h5>Save Favorites</h5>
            <p class="text-muted mb-0">Bookmark books you love and come back to them anytime.</p>
        </div>
    </div>
</div>

@if (User.Identity.IsAuthenticated)
{
    <div class="mt-4 p-3" style="background:rgba(200,150,62,0.08); border:1px solid var(--accent); border-radius:var(--radius); text-align:center;">
        <p class="mb-2">
            <i class="fa-solid fa-user-check me-2" style="color:var(--accent);"></i>
            Welcome back, <strong>@User.Identity.Name</strong>!
        </p>
        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <a asp-controller="Store" asp-action="Index" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-store me-1"></i>Go to Store
            </a>
            <a asp-controller="Favorites" asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fa-solid fa-heart me-1"></i>My Favorites
            </a>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fa-solid fa-cart-shopping me-1"></i>My Cart
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="AdminOrder" asp-action="OrdersList" class="btn btn-secondary btn-sm">
                    <i class="fa-solid fa-list me-1"></i>Manage Orders
                </a>
                <a asp-controller="Books" asp-action="Create" class="btn btn-secondary btn-sm">
                    <i class="fa-solid fa-plus me-1"></i>Add Book
                </a>
            }
        </div>
    </div>
}
