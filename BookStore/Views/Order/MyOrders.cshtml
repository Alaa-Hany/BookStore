@model IEnumerable<BookStore.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <h2 class="mb-4"><i class="fa-solid fa-truck me-2"></i>My Orders</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fa-solid fa-circle-info me-2"></i>
            You haven't placed any orders yet. <a asp-controller="Store" asp-action="Index">Start shopping</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model)
            {
                <div class="col-12 mb-4">
                    @{
                        string cardBorder = "";
                        string badgeClass = "";
                        string badgeText = "";
                        string badgeIcon = "";

                        if (order.IsDelivered)
                        {
                            cardBorder = "border-success";
                            badgeClass = "bg-success";
                            badgeText = "Delivered";
                            badgeIcon = "fa-solid fa-circle-check me-1";
                        }
                        else if (order.IsShipped)
                        {
                            cardBorder = "border-info";
                            badgeClass = "bg-info";
                            badgeText = "Shipped";
                            badgeIcon = "fa-solid fa-truck-fast me-1";
                        }
                        else
                        {
                            cardBorder = "border-warning";
                            badgeClass = "bg-warning";
                            badgeText = "Pending";
                            badgeIcon = "fa-solid fa-clock me-1";
                        }
                    }

                    <div class="card @cardBorder">
                        <div class="card-header bg-light">
                            <div class="d-flex justify-content-between align-items-center flex-wrap">
                                <span>
                                    <strong>Order #@order.Id</strong> -
                                    @order.OrderPlaced.ToString("MMM dd, yyyy - hh:mm tt")
                                </span>
                                <span class="badge @badgeClass">
                                    <i class="@badgeIcon"></i>@badgeText
                                </span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-8">
                                    <h6>Books Ordered:</h6>
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Book</th>
                                                <th>Qty</th>
                                                <th>Price</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in order.OrderItems)
                                            {
                                                <tr>
                                                    <td>@(item.Book?.Title ?? "Unknown")</td>
                                                    <td>@item.Quantity</td>
                                                    <td>@item.Price.ToString("C")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-md-4 text-end">
                                    <h5>Total: @order.OrderTotal.ToString("C")</h5>

                                    @if (order.IsShipped && !order.IsDelivered)
                                    {
                                        <form asp-action="ConfirmReceipt" asp-route-id="@order.Id" method="post">
                                            <button type="submit" class="btn btn-success btn-sm mt-2">
                                                <i class="fa-solid fa-circle-check me-1"></i>Confirm Receipt
                                            </button>
                                        </form>
                                    }
                                    else if (order.IsDelivered && order.DeliveredDate.HasValue)
                                    {
                                        <small class="text-success d-block mt-2">Delivered on @order.DeliveredDate.Value.ToString("MMM dd, yyyy")</small>
                                    }
                                    else if (order.IsShipped && !order.IsDelivered)
                                    {
                                        <small class="text-info d-block mt-2">Your order is on the way!</small>
                                    }
                                    else if (!order.IsShipped && !order.IsDelivered)
                                    {
                                        <small class="text-muted d-block mt-2">Your order is being processed</small>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>