@model BookStore.Models.Book
@{
    ViewData["Title"] = "Details";
}

<style>
    .toast-notification {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: #2d7a4f;
        color: white;
        padding: 15px 25px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
        z-index: 1000;
        animation: slideInRight 0.3s ease;
        font-family: 'DM Sans', sans-serif;
    }

        .toast-notification i {
            font-size: 1.5rem;
        }

        .toast-notification .toast-content {
            display: flex;
            flex-direction: column;
        }

        .toast-notification .toast-title {
            font-weight: 700;
            margin-bottom: 3px;
        }

        .toast-notification .toast-message {
            font-size: 0.85rem;
            opacity: 0.9;
        }

    @@keyframes slideInRight {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes fadeOut {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
            visibility: hidden;
        }
    }

    .book-img-details-wrapper {
        background: #f8f9fa;
        border-radius: 16px;
        padding: 1rem;
        text-align: center;
    }

    .book-img-details {
        width: 100%;
        max-height: 420px;
        object-fit: contain;
        object-position: center;
        border-radius: 12px;
    }

    .book-details-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
</style>

<div class="row g-4 mt-1" style="animation: fadeUp 0.4s ease;">
    <div class="col-12 col-md-5">
        <div class="book-img-details-wrapper">
            <img src="@Model.ImageUrl" class="book-img-details" alt="@Model.Title" />
        </div>
    </div>
    <div class="col-12 col-md-7">
        <div class="book-details-card h-100">
            <h1 class="mb-1" style="font-size:2rem;">@Model.Title</h1>
            <p class="text-muted mb-3">by <strong>@Model.Author</strong></p>

            <div class="mb-3" style="font-size:1.8rem; color:var(--accent); font-family:'Playfair Display',serif; font-weight:700;">
                @Model.Price.ToString("c")
            </div>

            <hr style="border-color:var(--border);" />

            <dl class="row mb-0">
                <dt class="col-sm-4">Language</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Language)</dd>
                <dt class="col-sm-4">ISBN</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.ISBN)</dd>
                <dt class="col-sm-4">Published</dt>
                <dd class="col-sm-8">@Model.DatePublished.ToString("MMMM dd, yyyy")</dd>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(m => m.Description)</dd>
                }
            </dl>

            <hr style="border-color:var(--border);" />

            <div class="d-flex gap-2 flex-wrap mt-3">
                <a asp-action="Index" class="btn btn-warning">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to Store
                </a>
                <button type="button" class="btn btn-primary add-to-cart-details" data-id="@Model.Id" data-title="@Model.Title">
                    <i class="fa-solid fa-cart-plus me-1"></i>Add to Cart
                </button>
                <button type="button" class="btn btn-outline-danger add-to-favorites-details" data-id="@Model.Id" data-title="@Model.Title">
                    <i class="fa-solid fa-heart me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showToast(title, message, type = 'success') {
            const toast = document.createElement('div');
            toast.className = 'toast-notification';
            toast.style.background = type === 'success' ? '#2d7a4f' : type === 'warning' ? '#c8963e' : '#e74c3c';
            toast.innerHTML = `
                <i class="fa-solid ${type === 'success' ? 'fa-circle-check' : type === 'warning' ? 'fa-triangle-exclamation' : 'fa-circle-exclamation'}"></i>
                <div class="toast-content">
                    <span class="toast-title">${title}</span>
                    <span class="toast-message">${message}</span>
                </div>
            `;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.animation = 'fadeOut 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        // Add to Cart from Details page
        document.querySelectorAll('.add-to-cart-details').forEach(button => {
            button.addEventListener('click', async function(e) {
                e.preventDefault();
                const bookId = this.getAttribute('data-id');
                const bookTitle = this.getAttribute('data-title');
                const originalHtml = this.innerHTML;

                this.disabled = true;
                this.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Adding...';

                try {
                    const response = await fetch(`/Store/AddToCartAjax/${bookId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getCsrfToken()
                        }
                    });
                    const data = await response.json();

                    this.disabled = false;

                    if (data.success) {
                        this.innerHTML = '<i class="fa-solid fa-cart-plus me-1"></i>Add to Cart';
                        showToast('Added to Cart!', `${bookTitle} added to your cart`, 'success');
                    } else {
                        this.innerHTML = originalHtml;
                        if (data.message === 'Please login first') {
                            showToast('Login Required', 'Please login to add to cart', 'warning');
                            setTimeout(() => {
                                window.location.href = '/Identity/Account/Login';
                            }, 2000);
                        } else {
                            showToast('Error', data.message || 'Something went wrong', 'error');
                        }
                    }
                } catch (error) {
                    this.disabled = false;
                    this.innerHTML = originalHtml;
                    showToast('Error', 'Something went wrong', 'error');
                }
            });
        });

        // Add to Favorites from Details page
        document.querySelectorAll('.add-to-favorites-details').forEach(button => {
            button.addEventListener('click', async function(e) {
                e.preventDefault();
                const bookId = this.getAttribute('data-id');
                const bookTitle = this.getAttribute('data-title');
                const originalHtml = this.innerHTML;

                this.disabled = true;
                this.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

                try {
                    const response = await fetch(`/Favorites/AddToFavoritesAjax?bookId=${bookId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': getCsrfToken()
                        }
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    const data = await response.json();
                    console.log('Response:', data);

                    this.disabled = false;

                    if (data.success) {
                        this.innerHTML = '<i class="fa-solid fa-heart me-1"></i>Save';
                        showToast('Added to Favorites!', data.message, 'success');
                    } else {
                        this.innerHTML = originalHtml;
                        if (data.message === 'Please login first') {
                            showToast('Login Required', 'Please login to add to favorites', 'warning');
                            setTimeout(() => {
                                window.location.href = '/Identity/Account/Login';
                            }, 2000);
                        } else if (data.message && data.message.includes('already')) {
                            showToast('Already in Favorites', data.message, 'warning');
                        } else {
                            showToast('Error', data.message || 'Something went wrong', 'error');
                        }
                    }
                } catch (error) {
                    this.disabled = false;
                    this.innerHTML = originalHtml;
                    console.error('Fetch error:', error);
                    showToast('Error', 'Something went wrong', 'error');
                }
            });
        });
    </script>
}