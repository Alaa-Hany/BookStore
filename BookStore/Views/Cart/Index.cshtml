@model BookStore.Models.Cart

<div class="page-header">
    <h1><i class="fa-solid fa-cart-shopping me-2" style="color:var(--accent)"></i>Your Cart</h1>
</div>

<div id="cart-container">
    @if (Model.CartItems.Count > 0)
    {
        <div class="cart-table-container">
            <table class="table" id="cart-table">
                <thead>
                    <tr>
                        <th style="width:70px;"></th>
                        <th>Book</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th style="width:60px;"></th>
                    </tr>
                </thead>
                <tbody id="cart-items">
                    @foreach (var item in Model.CartItems)
                    {
                        var bookTotal = item.Book.Price * item.Quantity;
                        <tr id="item-@item.Book.Id">
                            <td>
                                <a class="a-cleanup" asp-controller="Store" asp-action="Details" asp-route-id="@item.Id">
                                    <img src="@item.Book.ImageUrl" style="height:56px;width:44px;object-fit:cover;border-radius:6px;box-shadow:var(--shadow-sm);" />
                                </a>
                            </td>
                            <td>
                                <a class="a-cleanup" asp-controller="Store" asp-action="Details" asp-route-id="@item.Id">
                                    <strong>@item.Book.Title</strong>
                                </a>
                            </td>
                            <td class="item-price" style="color:var(--accent);font-weight:700;">@item.Book.Price.ToString("c")</td>
                            <td>
                                <div class="qty-control">
                                    <button type="button" class="decrease-qty btn btn-sm btn-outline-secondary" data-id="@item.Book.Id" title="Decrease">
                                        <i class="fa-solid fa-minus"></i>
                                    </button>
                                    <span class="qty-badge mx-2" id="qty-@item.Book.Id">@item.Quantity</span>
                                    <button type="button" class="increase-qty btn btn-sm btn-outline-secondary" data-id="@item.Book.Id" title="Increase">
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                </div>
                            </td>
                            <td class="item-total" id="total-@item.Book.Id" style="color:var(--accent);font-weight:700;">@bookTotal.ToString("c")</td>
                            <td>
                                <button type="button" class="btn btn-outline-danger btn-sm remove-item" data-id="@item.Book.Id" title="Remove">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-bold">Order Total:</td>
                        <td colspan="2" style="color:var(--accent);font-weight:700;font-size:1.2rem;" id="cart-total">
                            @(((decimal)ViewBag.Total).ToString("c"))
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <a asp-controller="Cart" asp-action="ClearCart" class="btn btn-danger">
                <i class="fa-solid fa-trash-can me-1"></i>Empty Cart
            </a>
            <a asp-controller="Store" asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>Continue Shopping
            </a>
            <a asp-controller="Order" asp-action="Checkout" class="btn btn-success btn-lg">
                Checkout <i class="fa-solid fa-angles-right ms-1"></i>
            </a>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-cart-shopping"></i>
            <h3>Your cart is empty</h3>
            <p class="text-muted">Looks like you haven't added any books yet.</p>
            <a asp-controller="Store" asp-action="Index" class="btn btn-primary mt-2">
                <i class="fa-solid fa-book me-1"></i>Browse Books
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Helper function to get CSRF token
        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        // Format currency
        function formatCurrency(value) {
            return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value);
        }

        // Update cart totals
        function updateCartTotal(newTotal) {
            document.getElementById('cart-total').innerText = formatCurrency(newTotal);
        }

        // Update item row
        function updateItemRow(bookId, newQuantity, newItemTotal, cartTotal) {
            document.getElementById(`qty-${bookId}`).innerText = newQuantity;
            document.getElementById(`total-${bookId}`).innerText = formatCurrency(newItemTotal);
            if (cartTotal !== undefined) {
                updateCartTotal(cartTotal);
            }
        }

        // Remove item row
        function removeItemRow(bookId, cartTotal, itemCount) {
            const row = document.getElementById(`item-${bookId}`);
            if (row) row.remove();
            updateCartTotal(cartTotal);

            if (itemCount === 0) {
                location.reload();
            }
        }

        // Increase quantity AJAX
        document.querySelectorAll('.increase-qty').forEach(button => {
            button.addEventListener('click', async function() {
                const bookId = this.getAttribute('data-id');
                const response = await fetch(`/Cart/IncreaseQuantityAjax/${bookId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    }
                });
                const data = await response.json();
                if (data.success) {
                    updateItemRow(bookId, data.newQuantity, data.newItemTotal, data.cartTotal);
                }
            });
        });

        // Decrease quantity AJAX
        document.querySelectorAll('.decrease-qty').forEach(button => {
            button.addEventListener('click', async function() {
                const bookId = this.getAttribute('data-id');
                const response = await fetch(`/Cart/DecreaseQuantityAjax/${bookId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    }
                });
                const data = await response.json();
                if (data.success) {
                    if (data.itemRemoved) {
                        removeItemRow(bookId, data.cartTotal, data.itemCount);
                    } else {
                        updateItemRow(bookId, data.newQuantity, data.newItemTotal, data.cartTotal);
                    }
                }
            });
        });

        // Remove item AJAX
        document.querySelectorAll('.remove-item').forEach(button => {
            button.addEventListener('click', async function() {
                const bookId = this.getAttribute('data-id');
                const response = await fetch(`/Cart/RemoveFromCartAjax/${bookId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    }
                });
                const data = await response.json();
                if (data.success) {
                    removeItemRow(bookId, data.cartTotal, data.itemCount);
                }
            });
        });
    </script>
}