@model List<BookStore.Models.Favorite>
@{
    ViewData["Title"] = "My Favorites";
}

<style>
    .toast-notification {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: #2d7a4f;
        color: white;
        padding: 15px 25px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
        z-index: 1000;
        animation: slideInRight 0.3s ease;
        font-family: 'DM Sans', sans-serif;
    }

        .toast-notification i {
            font-size: 1.5rem;
        }

        .toast-notification .toast-content {
            display: flex;
            flex-direction: column;
        }

        .toast-notification .toast-title {
            font-weight: 700;
            margin-bottom: 3px;
        }

        .toast-notification .toast-message {
            font-size: 0.85rem;
            opacity: 0.9;
        }

    @@keyframes slideInRight {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes fadeOut {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
            visibility: hidden;
        }
    }

    .fav-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .fav-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .fav-card .card-body {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

    .book-card-wrapper {
        margin-bottom: 1rem;
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header">
    <h2><i class="fa-solid fa-heart me-2" style="color:#e74c3c;"></i>My Favorite Books</h2>
    <span class="ms-auto text-muted small" id="favorites-count">@Model.Count items</span>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="fa-regular fa-heart"></i>
        <h3>No favorites yet</h3>
        <p class="text-muted">Browse our store and save books you love!</p>
        <a asp-controller="Store" asp-action="Index" class="btn btn-primary mt-2">
            <i class="fa-solid fa-book me-1"></i>Browse Books
        </a>
    </div>
}
else
{
    <div class="row g-3" id="favorites-container">
        @foreach (var favorite in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 book-card-wrapper" id="fav-@favorite.Id">
                <div class="fav-card">
                    <div style="overflow:hidden;">
                        <img src="@favorite.Book.ImageUrl" alt="@favorite.Book.Title" />
                    </div>
                    <div class="card-body p-3">
                        <h5 class="mb-1" style="font-size:1rem;">@favorite.Book.Title</h5>
                        <p class="text-muted small mb-2">@favorite.Book.Author</p>
                        @if (!string.IsNullOrEmpty(favorite.Book.Description))
                        {
                            <p class="small text-muted mb-3" style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
                                @favorite.Book.Description
                            </p>
                        }
                        <div class="d-flex gap-2 mt-auto">
                            <a asp-controller="Store" asp-action="Details" asp-route-id="@favorite.Book.Id" class="btn btn-primary btn-sm flex-fill">
                                <i class="fa-solid fa-eye me-1"></i>View
                            </a>
                            <button type="button" class="btn btn-danger btn-sm remove-favorite-ajax" data-id="@favorite.Id" data-title="@favorite.Book.Title" title="Remove from favorites">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function showToast(title, message, type = 'success') {
            const toast = document.createElement('div');
            toast.className = 'toast-notification';
            toast.style.background = type === 'success' ? '#2d7a4f' : '#c8963e';
            toast.innerHTML = `
                <i class="fa-solid ${type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation'}"></i>
                <div class="toast-content">
                    <span class="toast-title">${title}</span>
                    <span class="toast-message">${message}</span>
                </div>
            `;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.animation = 'fadeOut 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        document.querySelectorAll('.remove-favorite-ajax').forEach(button => {
            button.addEventListener('click', async function(e) {
                e.preventDefault();
                const favoriteId = this.getAttribute('data-id');
                const bookTitle = this.getAttribute('data-title');
                const row = document.getElementById(`fav-${favoriteId}`);

                this.disabled = true;
                this.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

                try {
                    const response = await fetch(`/Favorites/RemoveFromFavoritesAjax/${favoriteId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getCsrfToken()
                        }
                    });
                    const data = await response.json();

                    if (data.success) {
                        if (row) row.remove();
                        showToast('Removed!', `${bookTitle} removed from favorites`, 'success');
                        const remainingItems = document.querySelectorAll('.book-card-wrapper').length;
                        document.getElementById('favorites-count').innerText = `${remainingItems} items`;
                        if (remainingItems === 0) location.reload();
                    } else {
                        this.disabled = false;
                        this.innerHTML = '<i class="fa-solid fa-trash-can"></i>';
                        showToast('Error', data.message || 'Something went wrong', 'error');
                    }
                } catch (error) {
                    this.disabled = false;
                    this.innerHTML = '<i class="fa-solid fa-trash-can"></i>';
                    showToast('Error', 'Something went wrong', 'error');
                }
            });
        });
    </script>
}